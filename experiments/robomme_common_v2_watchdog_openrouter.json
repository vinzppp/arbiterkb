  "research_branch": "research/perception-belief-robomme",
  "transport": {
    "provider": "openrouter",
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "semantic_model": "gpt-6-luna",
    "wire_model": "openai/gpt-6-luna",
    "fallback_models": []
  },
  "arms": ["fullhist", "memi", "soft", "arbiter"],
  "model": "openai/gpt-6-luna",
  "effort": "low",
  "max_tokens": 32768,
  "timeout_s": 45,
  "llm_policy": {
    "request_timeout_s": 45,
    "call_wall_s": 120,
    "max_attempts": 2,
    "retry_on": ["HTTP 408", "HTTP 409", "HTTP 429", "HTTP >=500", "URL/timeout/socket error"],
    "backoff_cap_s": 2,
    "fallback_allowed": false,
    "api_failure_terminal": "infrastructure_error"
  },
  "watchdog": {
    "episode_wall_s": 600,
    "reset_wall_s": 180,
    "llm_call_wall_s": 120,
    "executor_command_wall_s": 180,
    "max_high_level_actions": 20,
    "poll_interval_s": 0.25,
    "terminate_grace_s": 10,
    "kill_grace_s": 5,
    "process_isolation": "fresh process group per arm-task-episode-observation cell",
    "cleanup": "SIGTERM process group, then SIGKILL after grace; fresh simulator process for the next cell",
    "loop_detection": {
      "diagnostic_only": true,
      "same_action_repeats": 6,
      "alternating_cycles": 3,
      "termination_effect": "none"
    }
  },
  "threshold_basis": {
    "v1_completed_episode_n": 15,
    "v1_completed_episode_max_s": 198.8,
    "v1_completed_decision_n": 31,
    "v1_completed_decision_max_s": 58.7,
    "v1_completed_llm_max_s": 12.332,
    "v1_incomplete_observed_s": 984,
    "rationale": "Arm-independent conservative ceilings: episode about 3x the longest completed v1 episode; executor about 3x the longest completed v1 decision; LLM about 9.7x the longest completed v1 call. The 20-action budget is above every completed v1 episode (max 4) and captures the diagnostic soft A/B oscillation without using arm identity."
  },
  "terminal_outcomes": {
    "success": {"primary_eligible": true, "primary_success": true},
    "task_failure": {"primary_eligible": true, "primary_success": false},
    "timeout": {"primary_eligible": true, "primary_success": false},
    "infrastructure_error": {"primary_eligible": false, "primary_success": null},
    "incomplete": {"primary_eligible": false, "primary_success": null}
  },
  "primary_analysis": {
    "intention_to_treat": "success/task_failure/timeout cells are scored; episode, action-budget, and executor timeouts count as failures",
    "excluded": "reset, LLM/API, worker, host, Docker, or simulator initialization infrastructure errors and incomplete cells",
    "gate": "all 16 smoke cells must terminate; any infrastructure_error, incomplete, missing cell, provenance mismatch, illegal action, wrong model, or systematic harness error is NO-GO",
    "reruns": "no within-run cell reruns; a failed smoke gate requires a new run id, and methodological changes require a new manifest hash"
  },
  "reset_policy": {
    "fresh_process_per_cell": true,
    "fixed_episode_resolution": true,
    "same_reset_digest_required_across_arms": true,
    "reset_retry_count": 0,
    "stale_event_without_result": "incomplete",
    "api_or_worker_failure_retry_count": 0
  },
  "prices_per_million": {
    "fresh_input": 0.10,
    "cached_input": 0.01,
    "cache_write": 0.125,
    "output": 0.50
  },
  "params_sha": "fe4e94112a74",
  "sources": {
