    "total_cells": 144,
    "primary_effect": "paired success risk difference per task and pooled",
    "uncertainty": "Wilson intervals and paired bootstrap intervals",
    "tests": "exact paired McNemar",
    "multiplicity": "Holm correction over the six frozen contrasts within each reported family",
    "expected_serial_wall_h": 4.6,
    "hard_watchdog_wall_h": 24.0,
    "estimated_scored_api_cost_usd": 0.08,
    "api_cost_stop_usd": 0.50,
